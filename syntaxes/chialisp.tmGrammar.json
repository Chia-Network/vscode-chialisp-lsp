{
  "scopeName": "source.chialisp",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#double-string"
    },
    {
      "include": "#single-string"
    },
    {
      "include": "#parenform"
    },
    {
      "include": "#atom"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.chialisp",
      "match": ";.*$"
    },
    "double-string": {
      "name": "string.quoted.double.chialisp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.chialisp",
          "match": "\\\\."
        }
      ]
    },
    "single-string": {
      "name": "string.quoted.single.chialisp",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.chialisp",
          "match": "\\\\."
        }
      ]
    },
    "parenform": {
      "begin": "#?\\(",
      "end": "\\)",
      "name": "meta.expression.chialisp",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "atom": {
      "name": "meta.atom.chialisp",
      "match": "[^\\s()\"';][^\\s)]*"
    }
  }
}
